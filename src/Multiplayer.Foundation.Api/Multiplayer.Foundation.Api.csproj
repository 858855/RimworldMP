<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Multiplayer.Foundation.Api</AssemblyName>
    <RootNamespace>Multiplayer.Foundation.Api</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <!-- The public contract for other mods (ADR 0029). No Harmony, no network types; only the game assembly for Thing, Def, Map. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckRimWorldManaged" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldManaged)/Assembly-CSharp.dll')" Text="Set RimWorldManaged to installed RimWorld 1.6 Managed directory." />
  </Target>
</Project>
