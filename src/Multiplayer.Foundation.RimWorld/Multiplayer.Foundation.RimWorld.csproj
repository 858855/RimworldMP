<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Multiplayer.Foundation.RimWorld</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <ProjectReference Include="../Multiplayer.Foundation.Network/Multiplayer.Foundation.Network.csproj" />
    <ProjectReference Include="../Multiplayer.Foundation.Hosting/Multiplayer.Foundation.Hosting.csproj" />
    <ProjectReference Include="../Multiplayer.Foundation.Session/Multiplayer.Foundation.Session.csproj" />
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RimWorldManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(RimWorldManaged)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(RimWorldManaged)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(RimWorldManaged)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(RimWorldManaged)/com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckRimWorldManaged" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldManaged)/Assembly-CSharp.dll')" Text="Set RimWorldManaged to installed RimWorld 1.6 Managed directory." />
    <Error Condition="!Exists('$(RimWorldManaged)/com.rlabrecque.steamworks.net.dll')" Text="Installed RimWorld Steamworks.NET assembly is required for the Steam transport." />
  </Target>
</Project>
