<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Multiplayer.Foundation.RimWorld</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Multiplayer.Foundation.Network/Multiplayer.Foundation.Network.csproj" />
    <ProjectReference Include="../Multiplayer.Foundation.Hosting/Multiplayer.Foundation.Hosting.csproj" />
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RimWorldManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(RimWorldManaged)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckRimWorldManaged" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldManaged)/Assembly-CSharp.dll')" Text="Set RimWorldManaged to installed RimWorld 1.6 Managed directory." />
  </Target>
</Project>
